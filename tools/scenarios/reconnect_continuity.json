{
  "name": "client-scoped-quic-reconnect-continuity",
  "initial_pose": {"dimension": "minecraft:overworld", "x": 0.5, "y": 100.0, "z": 0.5, "yaw": 0.0, "pitch": 0.0},
  "steps": [
    {"op": "wait_until", "field": "coverageMissing", "comparison": "==", "value": 0, "timeout_ms": 120000},
    {"op": "checkpoint", "name": "before_reconnect"},
    {"op": "reconnect_quic"},
    {"op": "trace", "duration_ms": 30000, "cadence_ms": 100},
    {"op": "checkpoint", "name": "after_reconnect"},
    {"op": "assert", "mode": "delta", "field": "connectionEpoch", "from": "before_reconnect", "to": "after_reconnect", "comparison": ">", "value": 0},
    {"op": "assert", "mode": "delta", "field": "sessionGeneration", "from": "before_reconnect", "to": "after_reconnect", "comparison": "==", "value": 0},
    {"op": "assert", "field": "active", "comparison": ">", "value": 0},
    {"op": "assert", "mode": "absence_of_failure"}
  ]
}
