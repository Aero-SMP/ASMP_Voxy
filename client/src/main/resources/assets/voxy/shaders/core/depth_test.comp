#version 430 core
layout(local_size_x=64) in;
layout(binding=0) uniform sampler2D Depth;
struct Bounds { vec4 rectangle; vec4 depth; };
layout(std430, binding=0) buffer Sections { Bounds sections[]; };
layout(location=0) uniform int Count;
void main() {
    uint id = gl_GlobalInvocationID.x; if (id >= uint(Count)) return;
    Bounds b = sections[id];
    if (b.depth.x <= 0) return; // Camera/near-plane intersection is always potentially visible.
    ivec2 base = textureSize(Depth, 0);
    float span = max((b.rectangle.z - b.rectangle.x) * base.x, (b.rectangle.w - b.rectangle.y) * base.y);
    int level = clamp(int(ceil(log2(max(span, 1)))), 0, textureQueryLevels(Depth) - 1);
    ivec2 size = textureSize(Depth, level);
    ivec2 lo = clamp(ivec2(floor(b.rectangle.xy * size)) - 1, ivec2(0), size - 1);
    ivec2 hi = clamp(ivec2(ceil(b.rectangle.zw * size)), ivec2(0), size - 1);
    float farthest = 0;
    for (int y = lo.y; y <= hi.y; y++) for (int x = lo.x; x <= hi.x; x++)
        farthest = max(farthest, texelFetch(Depth, ivec2(x, y), level).r);
    sections[id].depth.y = b.depth.x > farthest + 0.000001 ? 0 : 1;
}
