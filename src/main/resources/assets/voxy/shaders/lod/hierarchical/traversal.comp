#version 460 core

#define LOCAL_SIZE_MSK ((1<<LOCAL_SIZE_BITS)-1)
#define LOCAL_SIZE (1<<LOCAL_SIZE_BITS)
layout(local_size_x=LOCAL_SIZE) in;

#define ACTION_REFINE 0u
#define ACTION_COARSEN_CANDIDATE 1u

#import <voxy:lod/frustum.glsl>

layout(binding = SCENE_UNIFORM_BINDING, std140) uniform SceneUniform {
    mat4 MVP;
    ivec3 camSecPos;
    uint packedHizSize;
    vec3 camSubSecPos;
    float viewportArea;
    Frustum frustum;
    uint renderQueueMaxSize;
    uint frameId;
    uint actionEpoch;
    float renderDistance;
    uint finalPass;
    uint coarsenGraceFrames;
    uint detailPressure;
};

#import <voxy:lod/hierarchical/queue.glsl>
#import <voxy:lod/hierarchical/node.glsl>
#import <voxy:lod/hierarchical/screenspace.glsl>

layout(binding = DETAIL_ACTION_BINDING, std430) restrict buffer detailActionBuffer {
    uint actionCounts[DETAIL_BUCKET_COUNT];
    uvec4 detailActions[DETAIL_BUCKET_COUNT * ACTIONS_PER_BUCKET];
};

layout(binding = RENDER_QUEUE_BINDING, std430) restrict buffer renderQueueStruct {
    uint renderQueueIndex;
    uint[] renderQueue;
};

layout(binding = RENDER_TRACKER_BINDING, std430) restrict buffer renderTrackerArray {
    uint[] lastRenderFrame;
};

uint actionHash(uint value) {
    value ^= value >> 16;
    value *= 0x7feb352du;
    value ^= value >> 15;
    value *= 0x846ca68bu;
    return value ^ (value >> 16);
}

void addDetailAction(in UnpackedNode node, uint action, uint bucket) {
    // Rotate overflow selection by node and frame instead of favoring traversal order forever.
    uint mask = action == ACTION_REFINE ? 3u : 15u;
    if ((actionHash(getId(node) ^ actionEpoch) & mask) != 0u) return;
    bucket = min(bucket, DETAIL_BUCKET_COUNT - 1u);
    uint slot = atomicAdd(actionCounts[bucket], 1u);
    if (slot < ACTIONS_PER_BUCKET) {
        uvec2 position = getRawPos(node);
        detailActions[bucket * ACTIONS_PER_BUCKET + slot] =
                uvec4(position.x, position.y, action, actionEpoch);
    }
}

void enqueueChildren(in UnpackedNode node) {
    if (childListIsEmpty(node)) return;
    uint children = getChildCount(node);
    pushNodesInit(children);
    uint ptr = getChildPtr(node);
    for (int i = 0; i < children; i++) pushNode(ptr+i);
}

void enqueueSelfForRender(in UnpackedNode node) {
    if (renderQueueIndex < renderQueueMaxSize && !isEmptyMesh(node)) {
        uint renderIndex = atomicAdd(renderQueueIndex, 1);
        if (renderIndex < renderQueueMaxSize) renderQueue[renderIndex] = getMesh(node);
    }
}

vec3 closestPointToCamera(in UnpackedNode node) {
    vec3 nPos = vec3(((node.pos<<node.lodLevel)-camSecPos)<<5)-camSubSecPos;
    float scale = 1<<(node.lodLevel+5);
    return mix(mix(vec3(0), nPos, greaterThan(nPos, vec3(0))), nPos+scale,
            lessThan(nPos+scale, vec3(0)));
}

bool isWithinRenderDistance(in UnpackedNode node) {
    if (renderDistance<0.0f) return true;
    vec3 close = closestPointToCamera(node);
    return close.x*close.x+close.z*close.z <= renderDistance;
}

void addColdCoarsening(in UnpackedNode node, uint bucket) {
    if (finalPass != 0u && detailPressure != 0u
            && hasChildren(node) && !childListIsEmpty(node)
            && frameId - lastRenderFrame[getId(node)] >= coarsenGraceFrames) {
        addDetailAction(node, ACTION_COARSEN_CANDIDATE, bucket);
    }
}

void traverse(in UnpackedNode node) {
    setupScreenspace(node);
    if (outsideFrustum()) {
        addColdCoarsening(node, 1u);
        return;
    }
    if (isCulledByHiz()) {
        addColdCoarsening(node, 2u);
        return;
    }

    float score = projectedDetailScore();
    uint bucket = detailScoreBucket(score);
    if (finalPass != 0u) lastRenderFrame[getId(node)] = frameId;

    if (hasChildren(node) && !childListIsEmpty(node)) {
        if (finalPass != 0u && detailPressure != 0u) {
            addDetailAction(node, ACTION_COARSEN_CANDIDATE, max(3u, bucket));
        }
        // Installed topology, rather than a pixel threshold, determines the rendered cut.
        enqueueChildren(node);
        return;
    }

    // A retained parent is the complete fallback until its child group becomes active.
    if (hasMesh(node)) enqueueSelfForRender(node);
    if (finalPass != 0u && node.lodLevel != 0u && !isTerminal(node) && score >= 1.0f) {
        addDetailAction(node, ACTION_REFINE, bucket);
    }
}

void main() {
    uint nodeId = getCurrentNode();
    if (nodeId == SENTINAL_OUT_OF_BOUNDS) return;
    UnpackedNode node;
    unpackNode(node, nodeId);
    if (isWithinRenderDistance(node)) traverse(node);
    else addColdCoarsening(node, 0u);
}
